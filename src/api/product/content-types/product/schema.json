{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "code": {
      "type": "uid"
    },
    "description": {
      "type": "text"
    },
    "unit": {
      "type": "enumeration",
      "enum": ["kg", "m", "unit", "piece"]
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::item.item",
      "mappedBy": "product"
    },
    "orderProducts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order-product.order-product",
      "mappedBy": "product"
    },
    "suppliers": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::supplier.supplier",
      "inversedBy": "products"
    },
    "siigoId": {
      "type": "uid"
    },
    "priceList": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::price.price",
      "mappedBy": "product"
    },
    "unitsPerPackage": {
      "type": "integer",
      "default": 1
    },
    "barcode": {
      "type": "uid"
    },
    "category": {
      "type": "enumeration",
      "default": "Confeccion",
      "enum": ["Confeccion", "Tapiceria", "PrintLab"]
    },
    "collections": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::collection.collection",
      "mappedBy": "products"
    },
    "hideFor": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user",
      "mappedBy": "hideProducts"
    },
    "hasVariableQuantity": {
      "type": "boolean",
      "default": true
    },
    "type": {
      "type": "enumeration",
      "default": "variableQuantityPerItem",
      "enum": ["variableQuantityPerItem", "fixedQuantityPerItem", "cutItem"]
    },
    "productsForCuts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product.product",
      "mappedBy": "parentProduct"
    },
    "parentProduct": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product",
      "inversedBy": "productsForCuts"
    },
    "defaultCutProduct": {
      "type": "boolean",
      "default": false
    },
    "transformationFactor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::transformation-factor.transformation-factor",
      "inversedBy": "products"
    }
  }
}
